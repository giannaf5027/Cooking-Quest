generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String?
  resetToken      String?
  resetTokenExpiry DateTime?
  xp              Int      @default(0)
  level           Int      @default(1)
  isAdmin         Boolean  @default(false)
  mascot          String   @default("chef")
}
